{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Claude inside Minecraft: chat with Claude Code while you play, and let it see and build in your world.",
  "authors": ["ClaudeCraft contributors"],
  "license": "All Rights Reserved",
  "icon": "assets/claudecraft/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.claudecraft.platform.fabric.FabricClient"]
  },
  "depends": {
    "fabricloader": ">=0.15",
    "fabric-api-base": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-rendering-v1": "*",
    "${key_module}": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  }
}
